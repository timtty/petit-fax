; SIP trunk registration.
; One section per account; the section name is the account id.
; Fill in your trunk credentials, then restart the container.

[trunk]
enabled=yes
protocol=sip
; account username (SIP user part)
username=CHANGE_ME
; auth username, if different from username
;authname=CHANGE_ME
password=CHANGE_ME
; registrar host[:port], UDP
registrar=sip.example.com:5060
; SIP domain, if different from registrar host
;domain=example.com
; send all requests through this outbound proxy
;outbound=sip.example.com:5060
; registration refresh interval, seconds
interval=600
